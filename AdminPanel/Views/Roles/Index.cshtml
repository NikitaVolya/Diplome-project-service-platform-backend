@model RolesViewModel
@{
    ViewData["Title"] = "Roles";
    ViewData["Subtitle"] = "Who can do what in the panel and in the mobile app";
}

<div class="row g-3">
    <div class="col-12 col-xl-7">
        <div class="card table-card">
            <div class="card-header"><i class="bi bi-person-badge"></i> Roles</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th>Role</th>
                        <th>What it allows</th>
                        <th class="text-center">Users</th>
                        <th class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        <tr>
                            <td>
                                <span class="@Display.RoleClass(role.Name)">@role.Name</span>
                                @if (role.IsStaffRole)
                                {
                                    <div class="cell-muted mt-1"><i class="bi bi-shield-check"></i> panel access</div>
                                }
                            </td>
                            <td class="cell-muted">@role.Description</td>
                            <td class="text-center cell-strong">@role.UsersCount</td>
                            <td class="text-end">
                                @if (!AppRoles.All.Contains(role.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          data-confirm="Delete role &quot;@role.Name&quot;?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="name" value="@role.Name" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <span class="cell-muted small">built-in</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-plus-circle"></i> Add a role</div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" name="name" class="form-control form-control-sm"
                           placeholder="Role name" maxlength="64" required />
                    <button class="btn btn-sm btn-primary text-nowrap">
                        <i class="bi bi-plus-lg"></i> Create
                    </button>
                </form>
                <div class="form-text mt-2">
                    A custom role has no permissions of its own — the panel grants access by the five
                    built-in roles. Use custom roles for the mobile app or for future rules.
                </div>
            </div>
        </div>

        <div class="card table-card">
            <div class="card-header"><i class="bi bi-people"></i> Staff with panel access</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th>User</th>
                        <th>Roles</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Staff.Any())
                    {
                        <tr><td colspan="3" class="empty-state"><i class="bi bi-person-x"></i>No staff accounts</td></tr>
                    }

                    @foreach (var member in Model.Staff)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar avatar--sm">@Display.Initials(member.DisplayName)</span>
                                    <div>
                                        <div class="cell-strong">@member.DisplayName</div>
                                        <div class="cell-muted">@member.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @foreach (var role in member.Roles)
                                {
                                    <span class="@Display.RoleClass(role) me-1">@role</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Users" asp-action="Details" asp-route-id="@member.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
