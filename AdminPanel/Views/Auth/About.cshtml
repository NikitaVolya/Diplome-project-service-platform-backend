@model RegisterProfileViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = T("Реєстрація — Вибір");
    var executor = Model.IsExecutor;
}

@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }

<main class="auth">
    <div class="v-container auth__inner">
        <a class="auth-back" asp-action="Register"><span aria-hidden="true">&lsaquo;</span> @T("Назад")</a>

        <h1 class="auth__title">@T("Реєстрація")</h1>

        <partial name="_AuthSteps" model="2" />

        <div class="auth-card auth-card--wide">
            <span class="auth-card__icon" aria-hidden="true">
                <partial name="@(executor ? "_AuthCaseIcon" : "_AuthFaceIcon")" />
            </span>

            <h2>@T(executor ? "Про вас і ваш бізнес" : "Про вас")</h2>
            <p class="auth-card__lead">@T("Розкажіть трохи про себе")</p>

            <form method="post" asp-action="About" novalidate>
                <partial name="_AuthErrors" />

                @if (executor)
                {
                    <div class="auth-field">
                        <label>@T("Тип акаунту")</label>
                        <div class="auth-choice">
                            <label class="auth-radio">
                                <input type="radio" asp-for="IsCompany" value="false" checked="@(!Model.IsCompany)" data-company="false" />
                                <span>@T("Приватна особа")</span>
                            </label>
                            <label class="auth-radio">
                                <input type="radio" asp-for="IsCompany" value="true" checked="@Model.IsCompany" data-company="true" />
                                <span>@T("Компанія/ФОП")</span>
                            </label>
                        </div>
                    </div>
                }

                <div class="auth-grid">
                    <div class="auth-field">
                        <label asp-for="FirstName">@T("Ім’я")</label>
                        <span class="auth-input"><input asp-for="FirstName" autocomplete="given-name" placeholder="@T("Введіть ім’я")" /></span>
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="LastName">@T("Прізвище")</label>
                        <span class="auth-input"><input asp-for="LastName" autocomplete="family-name" placeholder="@T("Введіть прізвище")" /></span>
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                </div>

                @if (executor)
                {
                    <div class="auth-field auth-field--wide" data-company-field hidden="@(!Model.IsCompany)">
                        <label asp-for="CompanyName">@T("Назва компанії (необов’язково)")</label>
                        <span class="auth-input"><input asp-for="CompanyName" placeholder="@T("Введіть назву")" /></span>
                        <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                    </div>
                }

                <div class="auth-grid">
                    <div class="auth-field">
                        <label asp-for="City">@T("Місто")</label>
                        <span class="auth-input auth-input--select">
                            <select asp-for="City">
                                <option value="">@T("Виберіть місто")</option>
                                @foreach (var city in RegistrationOptions.Cities)
                                {
                                    <option value="@city">@T(city)</option>
                                }
                            </select>
                        </span>
                        <span asp-validation-for="City" class="field-validation-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="PostalCode">@T("Поштовий індекс (не обов’язково)")</label>
                        <span class="auth-input"><input asp-for="PostalCode" inputmode="numeric" placeholder="@T("Введіть індекс")" /></span>
                        <span asp-validation-for="PostalCode" class="field-validation-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="BirthDate">@T("Дата народження")</label>
                        <span class="auth-input">
                            <input asp-for="BirthDate" type="date" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" placeholder="@T("Введіть дату народження")" />
                        </span>
                        <span asp-validation-for="BirthDate" class="field-validation-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Gender">@T("Стать (не обов’язково)")</label>
                        <span class="auth-input auth-input--select">
                            <select asp-for="Gender">
                                <option value="">@T("Виберіть стать")</option>
                                @foreach (var (value, label) in RegistrationOptions.Genders)
                                {
                                    <option value="@value">@T(label)</option>
                                }
                            </select>
                        </span>
                        <span asp-validation-for="Gender" class="field-validation-error"></span>
                    </div>

                    @if (executor)
                    {
                        <div class="auth-field">
                            <label asp-for="Experience">@T("Досвід роботи")</label>
                            <span class="auth-input auth-input--select">
                                <select asp-for="Experience">
                                    <option value="">@T("Оберіть досвід")</option>
                                    @foreach (var (value, label) in RegistrationOptions.Experience)
                                    {
                                        <option value="@value">@T(label)</option>
                                    }
                                </select>
                            </span>
                            <span asp-validation-for="Experience" class="field-validation-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="SpecializationCategoryId">@T("Спеціалізація")</label>
                            <span class="auth-input auth-input--select">
                                <select asp-for="SpecializationCategoryId">
                                    <option value="">@T("Оберіть категорію послуг")</option>
                                    @foreach (var direction in Model.Directions)
                                    {
                                        <option value="@direction.Id">@T(direction.Name)</option>
                                    }
                                </select>
                            </span>
                            <span asp-validation-for="SpecializationCategoryId" class="field-validation-error"></span>
                        </div>
                    }

                    
                    <div class="auth-field">
                        <label asp-for="Password">@T("Пароль")</label>
                        <span class="auth-input" data-auth-password>
                            <input asp-for="Password" type="password" autocomplete="new-password"
                                   placeholder="@T("Придумайте пароль")" data-auth-strength />
                            <button class="auth-eye" type="button" aria-label="@T("Показати пароль")" data-label-show="@T("Показати пароль")" data-label-hide="@T("Приховати пароль")"><partial name="_AuthEyeIcon" /></button>
                        </span>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">@T("Підтвердіть пароль")</label>
                        <span class="auth-input" data-auth-password>
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="@T("Повторіть пароль")" />
                            <button class="auth-eye" type="button" aria-label="@T("Показати пароль")" data-label-show="@T("Показати пароль")" data-label-hide="@T("Приховати пароль")"><partial name="_AuthEyeIcon" /></button>
                        </span>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="auth-rules auth-rules--inline" data-auth-rules>
                    <h3>@T("Пароль повинен містити:")</h3>
                    <ul>
                        <li data-rule="length">@T("Мінімум 8 символів")</li>
                        <li data-rule="case">@T("Велику та маленьку літери")</li>
                        <li data-rule="digit">@T("Цифру або спеціальний символ")</li>
                    </ul>
                </div>

                @if (executor)
                {
                    <div class="auth-field auth-field--wide">
                        <label asp-for="About">@T("Коротко про себе")</label>
                        <span class="auth-input auth-input--area">
                            <textarea asp-for="About" rows="5" placeholder="@T("Напишіть кілька слів про себе та свої послуги")"></textarea>
                        </span>
                        <span asp-validation-for="About" class="field-validation-error"></span>
                    </div>
                }

                <section class="auth-notify">
                    <h3>@T("Налаштування сповіщень")</h3>
                    <p>@T("Як ви хочете отримувати повідомлення")</p>
                    <div class="auth-notify__row">
                        <label class="auth-check"><input asp-for="NotifyByEmail" /> <span>Email</span></label>
                        <label class="auth-check"><input asp-for="NotifyBySms" /> <span>SMS</span></label>
                        <label class="auth-check"><input asp-for="NotifyByPush" /> <span>@T("Push повідомлення в додатку")</span></label>
                    </div>
                </section>

                <label class="auth-check auth-check--terms">
                    <input asp-for="AcceptTerms" />
                    <span>
                        @T("Я погоджуюсь з") <a asp-controller="Landing" asp-action="Index" asp-fragment="footer">@T("Умовами використання")</a>
                        @T("та") <a asp-controller="Landing" asp-action="Index" asp-fragment="footer">@T("Політикою конфіденційності")</a>
                    </span>
                </label>
                <span asp-validation-for="AcceptTerms" class="field-validation-error"></span>

                <button class="auth-submit auth-submit--center" type="submit">@T("Продовжити")</button>
            </form>
        </div>
    </div>
</main>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true" defer></script> }
