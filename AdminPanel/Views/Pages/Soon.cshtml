        <img class="soon__art" src="~/img/pages/soon.webp" width="1254" height="706"
             alt="@T("Дівчина з ноутбуком біля дорожнього бар’єра — сторінка ще в розробці")" />

        <h1>@T("Ми працюємо над цією сторінкою")</h1>
        <p>
            @T("Цей розділ ще в процесі розробки.")<br />
            @T("Зовсім скоро тут з’явиться щось цікаве та корисне для вас.")
        </p>
        <a class="soon__btn" asp-controller="Landing" asp-action="Index">
            @T("Повернутись на головну") <span aria-hidden="true">&#10230;</span>
        </a>
