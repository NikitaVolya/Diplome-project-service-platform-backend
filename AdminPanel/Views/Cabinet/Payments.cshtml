@model CabinetPaymentsViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = Model.Title;

    var types = new[] { ("all", T("Усі типи")), ("payment", T("Оплати")), ("refund", T("Повернення")) };

    var pager = new CabinetPagerModel
    {
        Page = Model.Transactions.Page,
        Pages = Model.Transactions.Pages,
        Action = "Payments",
        Route = new Dictionary<string, string?>
        {
            ["type"] = Model.Type,
            ["tab"] = Model.Tab,
            ["q"] = Model.Query.Length > 0 ? Model.Query : null
        }
    };
}

@section Styles { <link rel="stylesheet" href="~/css/cabinet.css" asp-append-version="true" /> }

<main class="cab">
    <div class="v-container">
        <div class="cab-top">
            <nav class="cab-crumbs" aria-label="@T("Навігація")">
                <a asp-controller="Landing" asp-action="Index">@T("Головна")</a>
                <span aria-hidden="true">&rsaquo;</span>
                <a asp-action="Index">@T("Особистий кабінет")</a>
            </nav>

            <div class="cab-head"><h1>@T("Платежі та рахунки")</h1></div>
        </div>

        <div class="cab-body">
            <partial name="_CabinetMenu" model="Model" />

            <div class="cab-main">
                <partial name="_CabinetNotices" model="Model" />

                <section class="cab-panel cab-panel--pay">
                    <p class="cab-panel__lead">@T("Вся інформація про ваші платежі, транзакції та рахунки")</p>

                    <div class="cab-stats">
                        <article class="cab-stat cab-stat--pay">
                            <span class="cab-stat__name"><i class="bi bi-wallet2" aria-hidden="true"></i> @T("Баланс гаманця")</span>
                            <span class="cab-stat__value">@CabinetFormat.Uah(Model.Wallet.Balance)</span>
                            <button class="cab-stat__btn" type="button" disabled title="@T("Поповнення зʼявиться разом із платіжним шлюзом")">
                                @T("Поповнити")
                            </button>
                        </article>

                        <article class="cab-stat cab-stat--pay">
                            <span class="cab-stat__name"><i class="bi bi-cash-coin" aria-hidden="true"></i> @T("Усього витрачено")</span>
                            <span class="cab-stat__value">@CabinetFormat.Uah(Model.Wallet.Spent)</span>
                            <span class="cab-stat__more">@T("За весь час")</span>
                        </article>

                        <article class="cab-stat cab-stat--pay">
                            <span class="cab-stat__name"><i class="bi bi-hourglass-split" aria-hidden="true"></i> @T("В очікуванні")</span>
                            <span class="cab-stat__value">@CabinetFormat.Uah(Model.Wallet.Pending)</span>
                            <span class="cab-stat__more">@PublicText.Count(Model.Wallet.PendingCount, "платіж", "платежі", "платежів")</span>
                        </article>

                        <article class="cab-stat cab-stat--pay">
                            <span class="cab-stat__name"><i class="bi bi-receipt" aria-hidden="true"></i> @T("Всього транзакцій")</span>
                            <span class="cab-stat__value">@Model.Wallet.Total</span>
                            <span class="cab-stat__more">@T("За весь час")</span>
                        </article>
                    </div>

                    <div class="cab-tabs">
                        <a asp-action="Payments" asp-route-tab="transactions" asp-route-type="@Model.Type"
                           class="@(Model.Tab == "transactions" ? "is-current" : null)">@T("Транзакції")</a>
                        <a asp-action="Payments" asp-route-tab="invoices" asp-route-type="@Model.Type"
                           class="@(Model.Tab == "invoices" ? "is-current" : null)">@T("Рахунки")</a>
                    </div>

                    <form class="cab-filters" method="get" asp-action="Payments">
                        <input type="hidden" name="tab" value="@Model.Tab" />

                        <div class="cab-field" style="width:236px">
                            <select name="type" aria-label="@T("Тип транзакції")" onchange="this.form.submit()">
                                @foreach (var (key, title) in types)
                                {
                                    <option value="@key" selected="@(Model.Type == key)">@title</option>
                                }
                            </select>
                        </div>

                        <label class="cab-find cab-find--plain" style="width:365px">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <input type="text" value="@($"{DateTime.Now:01.MM.yyyy} - {DateTime.Now:dd.MM.yyyy}")"
                                   readonly aria-label="@T("Період")" />
                        </label>

                        <label class="cab-find cab-find--plain" style="flex:1">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search" name="q" value="@Model.Query"
                                   placeholder="@T("Пошук замовлень за назвою, ID…")" aria-label="@T("Пошук транзакцій")" />
                        </label>
                    </form>

                    @if (Model.Tab == "invoices")
                    {
                        <p class="cab-empty">
                            @T("Рахунки-фактури зʼявляться, коли платформа почне їх виставляти. Усі платежі поки показано на вкладці «Транзакції».")
                        </p>
                    }
                    else
                    {
                        @if (Model.Transactions.Items.Count == 0)
                        {
                            <p class="cab-empty">@T("Транзакцій за цим фільтром немає.")</p>
                        }

                        @foreach (var tx in Model.Transactions.Items)
                        {
                            <article class="cab-tx">
                                <div class="cab-tx__date">
                                    @CabinetFormat.TableDate(tx.CreatedAt)<br />
                                    @tx.CreatedAt.ToString("HH.mm")
                                </div>

                                <div class="cab-tx__name">
                                    <b>@tx.Title</b>
                                    <span>@F("Замовлення {0}", tx.OrderId)</span>
                                </div>

                                <div class="cab-tx__kind">
                                    <i class="bi @(tx.Incoming ? "bi-arrow-up" : "bi-arrow-down")" aria-hidden="true"></i>
                                    @CabinetContent.PaymentKind(tx.Status)
                                </div>

                                <div class="cab-tx__sum @(tx.Incoming ? "is-in" : null)">
                                    @CabinetFormat.Signed(tx.Amount, tx.Incoming)
                                </div>

                                <span class="cab-pay cab-pay--@CabinetContent.PaymentTone(tx.Status)">
                                    @CabinetContent.PaymentTitle(tx.Status)
                                </span>

                                <a class="cab-order__go" asp-action="Order" asp-route-id="@tx.OrderId"
                                   aria-label="@F("Відкрити замовлення {0}", tx.Title)">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </article>
                        }

                        <partial name="_CabinetPager" model="pager" />
                    }

                    <div class="cab-help">
                        <i class="bi bi-headset" aria-hidden="true"></i>
                        <div>
                            <b>@T("Питання щодо платежів")</b>
                            <p>@T("Наші фахівці завжди готові допомогти вам 24/7")</p>
                        </div>
                        <a class="v-btn v-btn--soft" asp-action="Support">@T("Зв’язатися з підтримкою")</a>
                    </div>
                </section>
            </div>
        </div>
    </div>
</main>
