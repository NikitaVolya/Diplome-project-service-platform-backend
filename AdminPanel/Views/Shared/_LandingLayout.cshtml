<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Вибір — платформа пошуку перевірених виконавців та замовлення послуг." />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="landing">

@{
    var isStaff = User.Identity?.IsAuthenticated == true
                  && (User.IsInRole(AppRoles.Admin)
                      || User.IsInRole(AppRoles.Moderator)
                      || User.IsInRole(AppRoles.Support));
}

<header class="v-header">
    <div class="v-container v-header__row">
        <a class="v-logo" asp-controller="Landing" asp-action="Index">
            <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <defs>
                    <linearGradient id="vg" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#7C63F5" />
                        <stop offset="100%" stop-color="#3E3180" />
                    </linearGradient>
                </defs>
                <path d="M3 7 L13 25 L29 4" stroke="url(#vg)" stroke-width="5"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>вибір</span>
        </a>

        <a class="v-pill" href="#categories"><i class="bi bi-grid-3x3-gap-fill"></i> Каталог послуг</a>
        <a class="v-pill v-pill--light" href="#search"><i class="bi bi-search"></i> Пошуковий сервіс</a>

        <nav class="v-nav">
            <a href="#how">Допомога</a>
            <a href="#why">Блог</a>
            <a href="#services">Конкурси</a>
            <a href="#services">Вакансії</a>
            <a href="#footer">Профіль</a>
        </nav>

        <button class="v-burger" type="button" aria-label="Меню"><i class="bi bi-list"></i></button>

        @if (isStaff)
        {
            <a class="v-btn v-btn--primary" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Адмін-панель
            </a>
        }
        else
        {
            <a class="v-btn v-btn--ghost" asp-controller="Account" asp-action="Login">Увійти</a>
            <a class="v-btn v-btn--primary" asp-controller="Account" asp-action="Login">Реєстрація</a>
        }
    </div>
</header>

@RenderBody()

<div class="v-footer-wrap" id="footer">
    <footer class="v-footer">
        <div class="v-container v-footer__grid">
            <div class="v-footer__about">
                <a class="v-logo" asp-controller="Landing" asp-action="Index">
                    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
                        <path d="M3 7 L13 25 L29 4" stroke="#624ECC" stroke-width="5"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>вибір</span>
                </a>
                <p>
                    Єдина платформа для пошуку перевірених виконавців та розвитку вашого бізнесу
                </p>
                <div class="v-social">
                    <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Viber"><i class="bi bi-chat-dots-fill"></i></a>
                </div>
            </div>

            <div>
                <h5>Платформа</h5>
                <ul>
                    <li><a href="#why">Безпека</a></li>
                    <li><a href="#services">Відгуки</a></li>
                    <li><a href="#">Блог</a></li>
                    <li><a href="#">Новини</a></li>
                    <li><a href="#how">FAQ</a></li>
                </ul>
            </div>

            <div>
                <h5>Для клієнтів</h5>
                <ul>
                    <li><a href="#how">Як замовити послугу</a></li>
                    <li><a href="#">Оплата та гарантії</a></li>
                    <li><a href="#">Повернення коштів</a></li>
                    <li><a href="#">Правила платформи</a></li>
                </ul>
            </div>

            <div>
                <h5>Для виконавців</h5>
                <ul>
                    <li><a href="#">Правила для виконавців</a></li>
                    <li><a href="#">Комісії та тарифи</a></li>
                    <li><a href="#">Поради виконавцям</a></li>
                    <li><a href="#">Центр допомоги</a></li>
                </ul>
            </div>

            <div>
                <h5>Компанія</h5>
                <ul>
                    <li><a href="#why">Про нас</a></li>
                    <li><a href="#footer">Контакти</a></li>
                    <li><a href="#">Кар'єра</a></li>
                    <li><a href="#">Партнери</a></li>
                    <li>
                        <a class="v-footer__admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-shield-lock"></i> Адмін-панель
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <h5>Підтримка</h5>
                <ul>
                    <li><span>Підтримка 24/7</span></li>
                    <li><a href="mailto:support@vybir.ua">support@vybir.ua</a></li>
                    <li><a href="tel:+380951234567">+38095 123 45 67</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <div class="v-bottom">
        <div class="v-container v-bottom__row">
            <span><i class="bi bi-c-circle"></i> @DateTime.UtcNow.Year Service Hub. Усі права захищені</span>
            <a href="#">Політика конфіденційності</a>
            <a href="#">Умови використання</a>
            <a href="#">Політика файлів cookie</a>
            <span>Українська <i class="bi bi-chevron-down"></i></span>
        </div>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
