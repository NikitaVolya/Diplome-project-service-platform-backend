<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Вибір — платформа пошуку перевірених виконавців та замовлення послуг." />
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    @* Шрифти макета: Onest, Inter, Unbounded — з Google Fonts. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;900&amp;family=Onest:wght@400;500;600;700&amp;family=Unbounded:wght@500&amp;display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="landing">

@{
    var isStaff = User.Identity?.IsAuthenticated == true
                  && (User.IsInRole(AppRoles.Admin)
                      || User.IsInRole(AppRoles.Moderator)
                      || User.IsInRole(AppRoles.Support));
}

<header class="v-header">
    <div class="v-container v-header__row">
        <a class="v-logo" asp-controller="Landing" asp-action="Index" aria-label="Вибір — на головну">
            <img src="~/img/logo.png" alt="Вибір" />
        </a>

        <a class="v-pill" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid-3x3-gap-fill"></i> Каталог послуг</a>
        <a class="v-pill v-pill--light" asp-controller="Landing" asp-action="Index" asp-fragment="search"><i class="bi bi-search"></i> Пошуковий сервіс</a>

        <nav class="v-nav" id="public-navigation" aria-label="Головне меню">
            <a class="v-nav__catalog" asp-controller="Catalog" asp-action="Index">Каталог послуг</a>
            <a class="v-nav__catalog" asp-controller="Account" asp-action="Login">Увійти</a>
            <a asp-controller="Landing" asp-action="Index" asp-fragment="how">Допомога</a>
            <a asp-controller="Landing" asp-action="Index" asp-fragment="why">Блог</a>
            <a asp-controller="Landing" asp-action="Index" asp-fragment="services">Конкурси</a>
            <a asp-controller="Landing" asp-action="Index" asp-fragment="services">Вакансії</a>
            <a href="#footer">Профіль</a>
        </nav>

        <button class="v-burger" type="button" aria-label="Відкрити меню" aria-expanded="false" aria-controls="public-navigation"><i class="bi bi-list" aria-hidden="true"></i></button>

        @if (isStaff)
        {
            <a class="v-btn v-btn--primary" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Адмін-панель
            </a>
        }
        else
        {
            <a class="v-btn v-btn--ghost" asp-controller="Account" asp-action="Login">Увійти</a>
            <button class="v-btn v-btn--primary" type="button" data-catalog-info>Реєстрація</button>
        }
    </div>
</header>

@RenderBody()

<div class="v-footer-wrap" id="footer">
    <footer class="v-footer">
        <img class="v-footer__mark" src="~/img/logo-watermark.png" alt="" aria-hidden="true" />

        <div class="v-container v-footer__grid">
            <div class="v-footer__about">
                <a class="v-logo" asp-controller="Landing" asp-action="Index" aria-label="Вибір — на головну">
                    <img src="~/img/logo.png" alt="Вибір" />
                </a>
                <p>
                    Єдина платформа для пошуку перевірених виконавців та розвитку вашого бізнесу
                </p>
                <div class="v-social">
                    <a href="#" aria-label="Google"><i class="bi bi-google-play"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Apple"><i class="bi bi-apple"></i></a>
                </div>
            </div>

            <div>
                <h5>Платформа</h5>
                <ul>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="why">Безпека</a></li>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="services">Відгуки</a></li>
                    <li><a href="#">Блог</a></li>
                    <li><a href="#">Новини</a></li>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="how">FAQ</a></li>
                </ul>
            </div>

            <div>
                <h5>Для клієнтів</h5>
                <ul>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="how">Як замовити послугу</a></li>
                    <li><a href="#">Оплата та гарантії</a></li>
                    <li><a href="#">Повернення коштів</a></li>
                    <li><a href="#">Правила платформи</a></li>
                </ul>
            </div>

            <div>
                <h5>Для виконавців</h5>
                <ul>
                    <li><a href="#">Правила для виконавців</a></li>
                    <li><a href="#">Комісії та тарифи</a></li>
                    <li><a href="#">Поради виконавцям</a></li>
                    <li><a href="#">Центр допомоги</a></li>
                </ul>
            </div>

            <div>
                <h5>Компанія</h5>
                <ul>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="why">Про нас</a></li>
                    <li><a href="#footer">Контакти</a></li>
                    <li><a href="#">Кар'єра</a></li>
                    <li><a href="#">Партнери</a></li>
                    <li>
                        <a class="v-footer__admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-shield-lock"></i> Адмін-панель
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <h5>Підтримка</h5>
                <ul>
                    <li><span>Підтримка 24/7</span></li>
                    <li><a href="mailto:support@vybir.ua">support@vybir.ua</a></li>
                    <li><a href="tel:+380951234567">+380 95 123 45 67</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <div class="v-bottom">
        <div class="v-container v-bottom__row">
            <span><i class="bi bi-c-circle"></i> @DateTime.UtcNow.Year Вибір. Усі права захищені</span>
            <a href="#">Політика конфіденційності</a>
            <a href="#">Умови використання</a>
            <a href="#">Політика файлів cookie</a>
            <span>Українська <i class="bi bi-chevron-down"></i></span>
        </div>
    </div>
</div>

<partial name="_PublicInfoDialog" />
<script src="~/js/public.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
