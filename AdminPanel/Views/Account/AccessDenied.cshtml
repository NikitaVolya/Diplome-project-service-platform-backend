@{
    ViewData["Title"] = "Access denied";
    Layout = "_LoginLayout";
}

<div class="login-card text-center">
    <i class="bi bi-shield-lock text-danger" style="font-size:2.5rem"></i>
    <h1 class="h5 mt-3">Access denied</h1>
    <p class="cell-muted">
        Your role does not allow you to open this section. Ask an administrator to grant
        the required permissions.
    </p>
    <a class="btn btn-primary w-100 mt-2" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-grid-1x2"></i> Back to dashboard
    </a>
</div>
