<!DOCTYPE html>
@{
    // Тема з профілю (або з cookie, якщо гість) діє на всьому публічному сайті й у кабінеті.
    var inCabinetPage = string.Equals(
        ViewContext.RouteData.Values["controller"] as string, "Cabinet", StringComparison.OrdinalIgnoreCase);
    var darkTheme = ThemePreference.IsDark(Context);
    var logoLight = Url.Content("~/img/logo.png");
    var logoDark = Url.Content("~/img/logo-dark.png");
}
<html lang="@PublicCulture.Current.Code" data-theme="@(darkTheme ? "dark" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@T("Вибір — платформа пошуку перевірених виконавців та замовлення послуг.")" />
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;900&amp;family=Onest:wght@400;500;600;700&amp;family=Unbounded:wght@500&amp;display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @* У кабінеті файл потрібен завжди — перемикач у налаштуваннях показує тему одразу. *@
    @if (darkTheme || inCabinetPage)
    {
        <meta name="color-scheme" content="@(darkTheme ? "dark" : "light")" />
        <link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
    }
</head>
<body class="landing">

@{
    var isStaff = User.Identity?.IsAuthenticated == true
                  && (User.IsInRole(AppRoles.Admin)
                      || User.IsInRole(AppRoles.Moderator)
                      || User.IsInRole(AppRoles.Support));

    var signedIn = User.Identity?.IsAuthenticated == true;

    var inCabinet = string.Equals(
        ViewContext.RouteData.Values["controller"] as string, "Cabinet", StringComparison.OrdinalIgnoreCase);

    var shortName = User.FindFirst(AppUserClaimsPrincipalFactory.ShortNameClaim)?.Value
                    ?? User.FindFirst(AppUserClaimsPrincipalFactory.FirstNameClaim)?.Value
                    ?? User.Identity?.Name
                    ?? string.Empty;

    var roleName = isStaff
        ? T("команда")
        : CabinetRole.Current(Context) == CabinetSide.Executor ? T("виконавець") : T("клієнт");

    var language = PublicCulture.Current;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var avatar = User.FindFirst(AppUserClaimsPrincipalFactory.AvatarClaim)?.Value
                 ?? CabinetArtwork.Portrait(
                        shortName,
                        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
}

<header class="v-header">
    <div class="v-container v-header__row">
        <a class="v-logo" asp-controller="Landing" asp-action="Index" aria-label="@T("Вибір — на головну")">
            <img src="@(darkTheme ? logoDark : logoLight)" data-logo-light="@logoLight" data-logo-dark="@logoDark" alt="@T("Вибір")" />
        </a>

        <a class="v-pill" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid-3x3-gap-fill"></i> @T("Каталог послуг")</a>
        <a class="v-pill v-pill--light" asp-controller="Search" asp-action="Index"><i class="bi bi-search"></i> @T("Пошуковий сервіс")</a>

        <nav class="v-nav" id="public-navigation" aria-label="@T("Головне меню")">
            <a class="v-nav__catalog" asp-controller="Catalog" asp-action="Index">@T("Каталог послуг")</a>
            <a class="v-nav__catalog" asp-controller="Account" asp-action="Login">@T("Увійти")</a>
            <a asp-controller="Pages" asp-action="Help">@T("Допомога")</a>
            <a asp-controller="Pages" asp-action="Blog">@T("Блог")</a>
            <a asp-controller="Landing" asp-action="Index" asp-fragment="services">@T("Конкурси")</a>
            <a asp-controller="Landing" asp-action="Index" asp-fragment="services">@T("Вакансії")</a>
            <a class="@(inCabinet ? "is-current" : null)" aria-current="@(inCabinet ? "page" : null)"
               asp-controller="Cabinet" asp-action="Index">@T("Профіль")</a>
        </nav>

        <button class="v-burger" type="button" aria-label="@T("Відкрити меню")" data-label-open="@T("Відкрити меню")" data-label-close="@T("Закрити меню")" aria-expanded="false" aria-controls="public-navigation"><i class="bi bi-list" aria-hidden="true"></i></button>

        @if (signedIn)
        {
            <details class="v-me">
                <summary title="@User.Identity!.Name">
                    <img src="@avatar" alt="" />
                    <span>
                        <b>@shortName</b>
                        <span>@roleName</span>
                    </span>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </summary>

                <div class="v-me__menu">
                    <a asp-controller="Cabinet" asp-action="Index">@T("Особистий кабінет")</a>
                    <a asp-controller="Cabinet" asp-action="Orders">@T("Мої замовлення")</a>
                    <a asp-controller="Cabinet" asp-action="Messages">@T("Повідомлення")</a>
                    <a asp-controller="Cabinet" asp-action="Settings">@T("Налаштування")</a>

                    @if (isStaff)
                    {
                        <a asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i> @T("Адмін-панель")
                        </a>
                    }

                    <form method="post" asp-controller="Auth" asp-action="Logout" class="v-logout">
                        <button type="submit">@T("Вийти")</button>
                    </form>
                </div>
            </details>
        }
        else
        {
            <a class="v-btn v-btn--ghost" asp-controller="Auth" asp-action="Login">@T("Увійти")</a>
            <a class="v-btn v-btn--primary" asp-controller="Auth" asp-action="Register" data-role-choice>@T("Реєстрація")</a>
        }
    </div>
</header>

@RenderBody()

<div class="v-footer-wrap" id="footer">
    <footer class="v-footer">
        <img class="v-footer__mark" src="~/img/logo-watermark.png" alt="" aria-hidden="true" />

        <div class="v-container v-footer__grid">
            <div class="v-footer__about">
                <a class="v-logo" asp-controller="Landing" asp-action="Index" aria-label="@T("Вибір — на головну")">
                    <img src="@(darkTheme ? logoDark : logoLight)" data-logo-light="@logoLight" data-logo-dark="@logoDark" alt="@T("Вибір")" />
                </a>
                <p>
                    @T("Єдина платформа для пошуку перевірених виконавців та розвитку вашого бізнесу")
                </p>
                <div class="v-social">
                    <a href="#" aria-label="Google"><i class="bi bi-google-play"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Apple"><i class="bi bi-apple"></i></a>
                </div>
            </div>

            <div>
                <h5>@T("Платформа")</h5>
                <ul>
                    <li><a asp-controller="Pages" asp-action="Security">@T("Безпека")</a></li>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="services">@T("Відгуки")</a></li>
                    <li><a asp-controller="Pages" asp-action="Blog">@T("Блог")</a></li>
                    <li><a asp-controller="Pages" asp-action="Blog" asp-route-category="Новини">@T("Новини")</a></li>
                    <li><a asp-controller="Pages" asp-action="Help">FAQ</a></li>
                </ul>
            </div>

            <div>
                <h5>@T("Для клієнтів")</h5>
                <ul>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="how">@T("Як замовити послугу")</a></li>
                    <li><a href="#">@T("Оплата та гарантії")</a></li>
                    <li><a href="#">@T("Повернення коштів")</a></li>
                    <li><a href="#">@T("Правила платформи")</a></li>
                </ul>
            </div>

            <div>
                <h5>@T("Для виконавців")</h5>
                <ul>
                    <li><a href="#">@T("Правила для виконавців")</a></li>
                    <li><a href="#">@T("Комісії та тарифи")</a></li>
                    <li><a href="#">@T("Поради виконавцям")</a></li>
                    <li><a asp-controller="Pages" asp-action="Help">@T("Центр допомоги")</a></li>
                </ul>
            </div>

            <div>
                <h5>@T("Компанія")</h5>
                <ul>
                    <li><a asp-controller="Landing" asp-action="Index" asp-fragment="why">@T("Про нас")</a></li>
                    <li><a href="#footer">@T("Контакти")</a></li>
                    <li><a href="#">@T("Кар'єра")</a></li>
                    <li><a href="#">@T("Партнери")</a></li>
                    <li>
                        <a class="v-footer__admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-shield-lock"></i> @T("Адмін-панель")
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <h5>@T("Підтримка")</h5>
                <ul>
                    <li><span>@T("Підтримка 24/7")</span></li>
                    <li><a href="mailto:support@vybir.ua">support@vybir.ua</a></li>
                    <li><a href="tel:+380951234567">+380 95 123 45 67</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <div class="v-bottom">
        <div class="v-container v-bottom__row">
            <span><i class="bi bi-c-circle"></i> @DateTime.UtcNow.Year @T("Вибір. Усі права захищені")</span>
            <a href="#">@T("Політика конфіденційності")</a>
            <a href="#">@T("Умови використання")</a>
            <a href="#">@T("Політика файлів cookie")</a>
            @* Перемикач мови. Список відкривається вгору — під ним уже край сторінки. *@
            <details class="v-lang">
                <summary aria-label="@T("Мова сайту"): @language.Title">
                    <span>@language.Title</span>
                    <svg class="v-lang__chevron" viewBox="0 0 16 10" aria-hidden="true"><path d="M1.5 1.5 8 8l6.5-6.5" /></svg>
                </summary>
                <div class="v-lang__panel">
                    <button class="v-lang__current" type="button" data-lang-close>
                        <span>@language.Title</span>
                        <svg class="v-lang__chevron" viewBox="0 0 16 10" aria-hidden="true"><path d="M1.5 1.5 8 8l6.5-6.5" /></svg>
                    </button>
                    <ul class="v-lang__menu" aria-label="@T("Мова сайту")">
                    @foreach (var option in PublicCulture.Languages.Where(l => l.Code != language.Code))
                    {
                        <li>
                            <a lang="@option.Code" hreflang="@option.Code"
                               asp-controller="Language" asp-action="Set"
                               asp-route-code="@option.Code" asp-route-returnUrl="@returnUrl">@option.Title</a>
                        </li>
                    }
                    </ul>
                </div>
            </details>
        </div>
    </div>
</div>

<partial name="_PublicInfoDialog" />
@if (!signedIn)
{
    <partial name="_RoleChoiceDialog" />
}
<script src="~/js/public.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
