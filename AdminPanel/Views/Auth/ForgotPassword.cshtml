@model ForgotPasswordViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = T("Відновлення пароля — Вибір");
}

@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }

<main class="auth">
    <div class="v-container auth__inner">
        <a class="auth-back" asp-action="Login"><span aria-hidden="true">&lsaquo;</span> @T("Назад")</a>

        <div class="auth-split">
            <div class="auth-split__aside">
                <span class="auth-split__icon" aria-hidden="true"><partial name="_AuthFaceIcon" /></span>
                <h2>@T("Забули пароль?")</h2>
                <p class="auth-step-name">@T("Крок 1")</p>
                <p>@T("Введіть e-mail, пов’язаний з вашим акаунтом,")<br />@T("і ми надішлемо вам код для скидання пароля")</p>
            </div>

            <div class="auth-split__form">
                <h1>@T("Відновлення пароля")</h1>
                <p>@T("Ми допоможемо вам отримати доступ до вашого акаунта!")</p>

                <form method="post" asp-action="ForgotPassword" novalidate>
                    <partial name="_AuthErrors" />

                    <div class="auth-field">
                        <label asp-for="Email">@T("Ваш e-mail")</label>
                        <span class="auth-input">
                            <input asp-for="Email" type="email" autocomplete="email" placeholder="@T("Введіть e-mail")" />
                        </span>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <button class="auth-submit" type="submit">@T("Надіслати код")</button>

                    <p class="auth-note">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        @T("Ваші дані у безпеці та не будуть передані третім особам")
                    </p>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true" defer></script> }
