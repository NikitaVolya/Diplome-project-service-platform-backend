@model LandingViewModel
@{
    ViewData["Title"] = T("Вибір — пошук виконавців та замовлення послуг");
    Layout = "_LandingLayout";
}

<section class="v-hero-wrap" id="search">
    <div class="v-container">
        <div class="v-hero">
            <div>
                <h1>@T("Замовляй чи заробляй — вибір за тобою!")</h1>
                <p class="v-hero__lead">
                    @T("Знаходьте перевірених фахівців для своїх завдань або знаходьте замовлення, щоб реалізувати свої навички та заробляти.")
                </p>

                <form class="v-search" method="get" asp-controller="Catalog" asp-action="Index" role="search">
                    <label class="v-search__field">
                        <span class="v-sr-only">@T("Послуга або категорія")</span>
                        <input type="search" name="q" maxlength="100" placeholder="@T("Яка послуга потрібна?")" />
                    </label>
                    <label class="v-search__field">
                        <i class="bi bi-geo-alt"></i>
                        <span class="v-sr-only">@T("Місто або район")</span>
                        <input type="text" name="city" maxlength="100" placeholder="@T("Місто або район")" />
                    </label>
                    <button type="submit" class="v-btn v-btn--primary">@T("Знайти")</button>
                </form>

                <div class="v-chips">
                    <span class="v-chips__label">@T("Популярне:")</span>
                    @foreach (var chip in new[] { "Дизайн", "Розробка", "Клінінг", "Блог", "Переклади" })
                    {
                        <a class="v-chip" asp-controller="Catalog" asp-action="Index" asp-route-q="@T(chip == "Клінінг" ? "Прибирання" : chip)">@T(chip)</a>
                    }
                </div>
            </div>

            <div class="v-hero__media">
                <img src="~/img/landing/hero.jpg" alt="@T("Команда за роботою в офісі")" />
            </div>
        </div>
    </div>
</section>

<section class="v-section v-section--tight" id="categories">
    <div class="v-container">
        <div class="v-section__head">
            <h2 class="v-section__title">@T("Популярні категорії:")</h2>
            <a class="v-link" asp-controller="Catalog" asp-action="Index">@T("Усі категорії") <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="v-cats">
            @foreach (var category in Model.Categories)
            {
                <a class="v-cat" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@(category.Id > 0 ? category.Id : (int?)null)" asp-route-q="@(category.Id > 0 ? null : category.Name)">
                    <span class="v-cat__icon">
                        <img src="@category.Icon" width="32" height="32" alt="" aria-hidden="true" />
                    </span>
                    <span class="v-cat__name">@T(category.Name)</span>
                </a>
            }
            @* Остання плитка веде до повного каталогу, тому в макеті вона без кольорового квадрата. *@
            <a class="v-cat v-cat--more" asp-controller="Catalog" asp-action="Index">
                <span class="v-cat__icon">
                    <img src="~/img/icons/cat-more.svg" alt="" aria-hidden="true" />
                </span>
                <span class="v-cat__name">@T("Більше")</span>
            </a>
        </div>
    </div>
</section>

<section class="v-section">
    <div class="v-container">
        <h2 class="v-h2 v-display v-center">@T("Одна платформа — дві можливості.")</h2>

        <div class="v-duo">
            <div class="v-duo__card">
                <h3>@T("Потрібна послуга?")</h3>
                <div class="v-duo__body">
                    <span class="v-duo__icon"><img src="~/img/icons/duo-need.svg" alt="" aria-hidden="true" /></span>
                    <span class="v-duo__text">
                        @T("Знайдіть спеціаліста для ремонту, прибирання, дизайну, навчання та інших завдань.")
                    </span>
                    <a class="v-btn v-btn--soft" asp-controller="Catalog" asp-action="Index">@T("Знайти виконавця")</a>
                </div>
            </div>

            <div class="v-duo__card">
                <h3>@T("Хочете заробляти?")</h3>
                <div class="v-duo__body">
                    <span class="v-duo__icon"><img src="~/img/icons/duo-earn.svg" alt="" aria-hidden="true" /></span>
                    <span class="v-duo__text">
                        @T("Створіть профіль, показуйте свої навички та знаходьте замовлення поруч із вами.")
                    </span>
                    <a class="v-btn v-btn--soft" asp-controller="Jobs" asp-action="Index">@T("Знайти замовлення")</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="v-section" id="how">
    <div class="v-container">
        <h2 class="v-h2 v-center">@T("Як це працює?")</h2>
        <p class="v-sub v-center">@T("Знайти потрібну людину — простіше, ніж здається")</p>

        <div class="v-steps__line">
            @for (var i = 1; i <= 4; i++)
            {
                <span class="v-steps__num">@i</span>
            }
        </div>

        <div class="v-steps">
            <div class="v-step">
                <img class="v-step__icon" src="~/img/icons/step-request.svg" alt="" aria-hidden="true" />
                <h4>@T("Створіть запит")</h4>
                <p>@T("Опишіть, що вам потрібно. Вкажіть деталі та бюджет.")</p>
            </div>
            <div class="v-step">
                <img class="v-step__icon" src="~/img/icons/step-choose.svg" alt="" aria-hidden="true" />
                <h4>@T("Оберіть виконавця")</h4>
                <p>@T("Порівняйте профілі, рейтинг, відгуки та ціну.")</p>
            </div>
            <div class="v-step">
                <img class="v-step__icon" src="~/img/icons/step-agree.svg" alt="" aria-hidden="true" />
                <h4>@T("Домовтеся про виконання")</h4>
                <p>@T("Підтвердьте замовлення та деталі.")</p>
            </div>
            <div class="v-step">
                <img class="v-step__icon" src="~/img/icons/step-result.svg" alt="" aria-hidden="true" />
                <h4>@T("Отримайте результат")</h4>
                <p>@T("Прийміть роботу та залиште відгук.")</p>
            </div>
        </div>
    </div>
</section>

<section class="v-why" id="why">
    <div class="v-container">
        <h2 class="v-h2 v-center">@T("Чому обирають") <span class="v-accent">@T("Вибір")</span>?</h2>
        <p class="v-sub v-center">
            @T("Ми допомагаємо швидше знаходити потрібних людей — без зайвих дзвінків, сумнівів і нескінченних пошуків.")
        </p>

        <div class="v-why__grid">
            <div class="v-why__item">
                <img class="v-why__icon" src="~/img/icons/why-verified.svg" alt="" aria-hidden="true" />
                <h4>@T("Перевірені виконавці")</h4>
                <p>@T("Профілі, рейтинги та відгуки допомагають зробити впевнений вибір.")</p>
            </div>
            <div class="v-why__item">
                <img class="v-why__icon" src="~/img/icons/why-fast.svg" alt="" aria-hidden="true" />
                <h4>@T("Швидкий пошук")</h4>
                <p>@T("Знаходьте потрібного спеціаліста за категорією, ціною та локацією.")</p>
            </div>
            <div class="v-why__item">
                <img class="v-why__icon" src="~/img/icons/why-secure.svg" alt="" aria-hidden="true" />
                <h4>@T("Безпечна взаємодія")</h4>
                <p>@T("Усі деталі замовлення та домовленості зручно зберігати на платформі.")</p>
            </div>
            <div class="v-why__item">
                <img class="v-why__icon" src="~/img/icons/why-fair.svg" alt="" aria-hidden="true" />
                <h4>@T("Чесні умови")</h4>
                <p>@T("Заздалегідь бачите вартість послуги та умови виконання.")</p>
            </div>
        </div>
    </div>
</section>

<section class="v-section" id="services">
    <div class="v-container">
        <div class="v-section__head">
            <h2 class="v-section__title">@T("Популярне поруч із вами:")</h2>
            <a class="v-link" asp-controller="Catalog" asp-action="Index">@T("Переглянути всі послуги") <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="v-services">
            @foreach (var service in Model.Services)
            {
                <a class="v-service" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@(service.CategoryId > 0 ? service.CategoryId : (int?)null)">
                    <div class="v-service__img">
                        <img src="@service.Image" alt="@T(service.Name)" loading="lazy" />
                    </div>
                    <div class="v-service__body">
                        <div class="v-service__name">@T(service.Name)</div>
                        <div class="v-service__meta">
                            @if (service.ReviewsCount > 0)
                            {
                                <div>
                                    <span class="star">★</span>
                                    @PublicText.Rating(service.Rating) (@PublicText.Reviews(service.ReviewsCount))
                                </div>
                            }
                            else
                            {
                                <div>@T("Ще немає відгуків")</div>
                            }
                            @if (service.FromPrice > 0) { <div>@PublicText.Price(service.FromPrice)</div> }
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="v-cta">
    <div class="v-container v-cta__inner">
        <div class="v-cta__img">
            <img src="~/img/landing/cta.jpg" alt="@T("Ідеї та рішення")" loading="lazy" />
        </div>
        <div class="v-center">
            <h2>@T("Є завдання? Знайдемо рішення.")</h2>
            <p>@T("Покажіть, що ви вмієте, і знайдіть своє наступне завдання.")</p>
            <div class="v-cta__buttons" style="justify-content:center">
                <a class="v-btn v-btn--soft" asp-controller="Catalog" asp-action="Index">@T("Знайти виконавця")</a>
                <a class="v-btn v-btn--soft" asp-controller="Jobs" asp-action="Index">@T("Знайти замовлення")</a>
            </div>
        </div>
    </div>
</section>
