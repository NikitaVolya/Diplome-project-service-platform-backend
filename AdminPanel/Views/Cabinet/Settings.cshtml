@model CabinetSettingsViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = Model.Title;

    var avatar = string.IsNullOrEmpty(Model.Avatar)
        ? CabinetArtwork.Portrait(Model.FirstName + " " + Model.LastName, Model.Email)
        : Model.Avatar;
}

@section Styles { <link rel="stylesheet" href="~/css/cabinet.css" asp-append-version="true" /> }

<main class="cab">
    <div class="v-container">
        <div class="cab-top">
            <nav class="cab-crumbs" aria-label="@T("Навігація")">
                <a asp-controller="Landing" asp-action="Index">@T("Головна")</a>
                <span aria-hidden="true">&rsaquo;</span>
                <a asp-action="Index">@T("Особистий кабінет")</a>
            </nav>

            <div class="cab-head">
                <h1>@T("Налаштування")</h1>
                <p>@T("Керуйте своїм акаунтом, сповіщеннями та безпекою.")</p>
            </div>
        </div>

        <div class="cab-body">
            <partial name="_CabinetMenu" model="Model" />

            <div class="cab-main">
                <partial name="_CabinetNotices" model="Model" />

                <form class="cab-set" method="post" asp-action="Settings">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="cab-errors"></div>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-person-badge" aria-hidden="true"></i> @T("Профіль")</h2>

                        <div class="cab-set__pair">
                            <div class="cab-field">
                                <label asp-for="FirstName">@T("Ім'я")</label>
                                <input asp-for="FirstName" type="text" required />
                            </div>

                            <div class="cab-field">
                                <label asp-for="LastName">@T("Прізвище")</label>
                                <input asp-for="LastName" type="text" required />
                            </div>

                            <div class="cab-set__inline">
                                <div class="cab-field">
                                    <label asp-for="Email">E-mail</label>
                                    @* Пошта — логін акаунта, її змінюють окремо з підтвердженням коду. *@
                                    <input asp-for="Email" type="email" readonly />
                                </div>
                                <a class="v-btn v-btn--soft" asp-controller="Auth" asp-action="ForgotPassword">@T("Змінити")</a>
                            </div>

                            <div class="cab-set__inline">
                                <div class="cab-field">
                                    <label asp-for="Phone">@T("Номер телефону")</label>
                                    <input asp-for="Phone" type="tel" />
                                </div>
                                <button class="v-btn v-btn--soft" type="submit">@T("Змінити")</button>
                            </div>
                        </div>

                        <div class="cab-set__card">
                            <span style="font-size:15px;color:#374151">@T("Фото профілю")</span>
                            <div class="cab-set__photo" style="margin-top:12px">
                                <img src="@avatar" alt="@T("Фото профілю")" />
                                <span>@T("JPG, PNG (максимально 2 Мб)")</span>
                                @* Поле файлу належить окремій формі avatar-form під основною:
                                   вкладати одну форму в іншу HTML не дозволяє. *@
                                <label class="v-btn v-btn--soft cab-photo-pick">
                                    @T("Змінити фото")
                                    <input type="file" name="photo" form="avatar-form"
                                           accept="image/jpeg,image/png,image/webp" data-avatar-input />
                                </label>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-shield-lock" aria-hidden="true"></i> @T("Безпека")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span style="letter-spacing:3px">••••••••••••</span>
                                <a class="v-btn v-btn--soft" asp-controller="Auth" asp-action="ForgotPassword">@T("Змінити")</a>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Двоетапна перевірка")</b>
                                    <span>@T("Додатковий рівень захисту вашого акаунту")</span>
                                </span>
                                @* Другий крок входу ще не зроблено: якби перемикач справді вмикав двоетапну
                                       перевірку, людина більше не змогла б увійти — коду надіслати нема куди.
                                       Тому показуємо стан, але не даємо його змінити. *@
                                <label class="cab-switch cab-switch--off"
                                       title="@T("Двоетапна перевірка зʼявиться разом із кодами входу")">
                                    <input type="checkbox" disabled checked="@Model.TwoFactor" />
                                    <input type="hidden" asp-for="TwoFactor" />
                                    <span></span>
                                </label>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-bell" aria-hidden="true"></i> @T("Сповіщення")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Електронна пошта")</b>
                                    <span>@T("Отримувати сповіщення на email")</span>
                                </span>
                                <label class="cab-switch"><input asp-for="NotifyByEmail" type="checkbox" /><span></span></label>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Push-сповіщення")</b>
                                    <span>@T("Отримувати сповіщення в додатку")</span>
                                </span>
                                <label class="cab-switch"><input asp-for="NotifyByPush" type="checkbox" /><span></span></label>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("SMS-сповіщення")</b>
                                    <span>@T("Отримувати важливі сповіщення на SMS")</span>
                                </span>
                                <label class="cab-switch"><input asp-for="NotifyBySms" type="checkbox" /><span></span></label>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Маркетингові розсилки")</b>
                                    <span>@T("Отримувати новини та акції")</span>
                                </span>
                                <label class="cab-switch"><input asp-for="NotifyMarketing" type="checkbox" /><span></span></label>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-eye-slash" aria-hidden="true"></i> @T("Конфіденційність")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Хто може бачити мій профіль")</b>
                                    <span>@T("Виконавець може бачити ваш основний профіль")</span>
                                </span>
                                <select asp-for="ProfileVisibility">
                                    @foreach (var option in CabinetContent.Visibility)
                                    {
                                        <option value="@option.Key" selected="@(Model.ProfileVisibility == option.Key)">@option.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Активність та статус")</b>
                                    <span>@T("Показувати статус онлайн виконавцям")</span>
                                </span>
                                <label class="cab-switch"><input asp-for="ShowOnlineStatus" type="checkbox" /><span></span></label>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Історія замовлень")</b>
                                    <span>@T("Дозволити виконавцям переглядати історію моїх замовлень")</span>
                                </span>
                                <label class="cab-switch"><input asp-for="ShareOrderHistory" type="checkbox" /><span></span></label>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-credit-card-2-front" aria-hidden="true"></i> @T("Платежі")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Основний спосіб оплати")</b>
                                    <span>@T("Карта, з якої списуються кошти за замовлення")</span>
                                </span>
                                <span style="display:flex;align-items:center;gap:18px">
                                    <span class="cab-skill">@(string.IsNullOrEmpty(Model.PaymentCard) ? T("Карту не додано") : Model.PaymentCard)</span>
                                    @* Прив'язка карти зʼявиться разом із платіжним шлюзом. *@
                                    <button class="v-btn v-btn--soft" type="button" disabled
                                            title="@T("Прив'язка карти зʼявиться пізніше")">@T("Змінити")</button>
                                </span>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Валюта рахунків")</b>
                                    <span>@T("У цій валюті показуються суми та рахунки")</span>
                                </span>
                                <select asp-for="Currency">
                                    @foreach (var option in CabinetContent.Currencies)
                                    {
                                        <option value="@option.Key" selected="@(Model.Currency == option.Key)">@option.Title</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-translate" aria-hidden="true"></i> @T("Мова та регіон")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span><b>@T("Мова інтерфейсу")</b></span>
                                <select asp-for="Language">
                                    @foreach (var option in CabinetContent.Languages)
                                    {
                                        <option value="@option.Key" selected="@(Model.Language == option.Key)">@option.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="cab-set__row">
                                <span><b>@T("Часовий пояс")</b></span>
                                <select asp-for="TimeZoneName">
                                    @foreach (var option in CabinetContent.TimeZones)
                                    {
                                        <option value="@option.Key" selected="@(Model.TimeZoneName == option.Key)">@option.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="cab-set__row">
                                <span><b>@T("Формат дати")</b></span>
                                <select asp-for="DateFormat">
                                    @foreach (var option in CabinetContent.DateFormats)
                                    {
                                        <option value="@option.Key" selected="@(Model.DateFormat == option.Key)">@option.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="cab-set__row">
                                <span><b>@T("Формат часу")</b></span>
                                <select asp-for="TimeFormat">
                                    @foreach (var option in CabinetContent.TimeFormats)
                                    {
                                        <option value="@option.Key" selected="@(Model.TimeFormat == option.Key)">@option.Title</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-eyeglasses" aria-hidden="true"></i> @T("Вигляд")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span><b>@T("Тема інтерфейсу")</b></span>
                                <span class="cab-theme">
                                    <input type="radio" id="theme-light" name="Theme" value="light" checked="@(Model.Theme != "dark")" />
                                    <label for="theme-light">@T("Світла")</label>
                                    <input type="radio" id="theme-dark" name="Theme" value="dark" checked="@(Model.Theme == "dark")" />
                                    <label for="theme-dark">@T("Темна")</label>
                                </span>
                            </div>
                        </div>
                    </section>

                    <section class="cab-set__group">
                        <h2><i class="bi bi-three-dots" aria-hidden="true"></i> @T("Інше")</h2>

                        <div class="cab-set__card">
                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Вийти з усіх пристроїв")</b>
                                    <span>@T("Ви вилогуєтесь з усіх пристроїв, окрім поточного")</span>
                                </span>
                                @* Вихід з інших пристроїв робиться оновленням стемпа безпеки — зробимо разом
                                   зі списком сесій, щоб людина бачила, що саме закривається. *@
                                <button class="cab-danger" type="button" disabled
                                        title="@T("Зʼявиться разом зі списком активних сесій")">@T("Вийти з усіх пристроїв")</button>
                            </div>

                            <div class="cab-set__row">
                                <span>
                                    <b>@T("Видалити акаунт")</b>
                                    <span>@T("Безповоротне видалення акаунту та всіх даних")</span>
                                </span>
                                @* Видалення акаунта зачіпає замовлення й платежі — робимо його через звернення
                                   до підтримки, щоб ніхто не стер історію одним випадковим натисканням. *@
                                <a class="cab-danger" style="display:inline-flex;align-items:center;justify-content:center"
                                   asp-action="Support">@T("Видалити акаунт")</a>
                            </div>
                        </div>
                    </section>

                    <div class="cab-set__act">
                        <button class="v-btn v-btn--primary" type="submit">@T("Зберегти зміни")</button>
                        <a class="v-btn v-btn--ghost" asp-action="Settings">@T("Скинути")</a>
                    </div>
                </form>

                <partial name="~/Views/Cabinet/_AvatarForm.cshtml" />
            </div>
        </div>
    </div>
</main>
