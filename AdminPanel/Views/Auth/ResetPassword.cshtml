@model ResetPasswordViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = T("Новий пароль — Вибір");
}

@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }

<main class="auth">
    <div class="v-container auth__inner">
        <a class="auth-back" asp-action="VerifyCode"><span aria-hidden="true">&lsaquo;</span> @T("Назад")</a>

        <div class="auth-split">
            <div class="auth-split__aside">
                <span class="auth-split__icon" aria-hidden="true"><partial name="_AuthFaceIcon" /></span>
                <h2>@T("Забули пароль?")</h2>
                <p class="auth-step-name">@T("Крок 3")</p>
                <p>@T("Створіть новий пароль")</p>
            </div>

            <div class="auth-split__form">
                <h1>@T("Відновлення пароля")</h1>
                <p>@T("Ми допоможемо вам отримати доступ до вашого акаунта!")</p>

                <form method="post" asp-action="ResetPassword" novalidate>
                    <partial name="_AuthErrors" />

                    <div class="auth-field">
                        <label asp-for="Password">@T("Новий пароль")</label>
                        <span class="auth-input" data-auth-password>
                            <input asp-for="Password" type="password" autocomplete="new-password"
                                   placeholder="@T("Введіть новий пароль")" data-auth-strength />
                            <button class="auth-eye" type="button" aria-label="@T("Показати пароль")" data-label-show="@T("Показати пароль")" data-label-hide="@T("Приховати пароль")">
                                <partial name="_AuthEyeIcon" />
                            </button>
                        </span>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="auth-rules" data-auth-rules>
                        <h3>@T("Пароль повинен містити:")</h3>
                        <ul>
                            <li data-rule="length">@T("Мінімум 8 символів")</li>
                            <li data-rule="case">@T("Велику та маленьку літери")</li>
                            <li data-rule="digit">@T("Цифру або спеціальний символ")</li>
                        </ul>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">@T("Підтвердіть пароль")</label>
                        <span class="auth-input" data-auth-password>
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                                   placeholder="@T("Повторіть новий пароль")" />
                            <button class="auth-eye" type="button" aria-label="@T("Показати пароль")" data-label-show="@T("Показати пароль")" data-label-hide="@T("Приховати пароль")">
                                <partial name="_AuthEyeIcon" />
                            </button>
                        </span>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button class="auth-submit" type="submit">@T("Перейти в особистий кабінет")</button>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true" defer></script> }
