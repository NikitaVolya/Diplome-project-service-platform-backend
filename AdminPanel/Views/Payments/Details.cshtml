@model AdminPaymentListItem
@{
    ViewData["Title"] = $"Payment #{Model.Id}";
    ViewData["Subtitle"] = Model.ExternalTransactionId;
}

<div class="mb-3">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to payments
    </a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-receipt"></i> Transaction
                <span class="@Display.PaymentStatusClass(Model.Status) ms-auto">@Model.Status</span>
            </div>
            <div class="card-body">
                <div class="kpi__value mb-3">@Model.Amount.ToString("N2") @Model.Currency</div>

                <dl class="mb-0">
                    <div class="stat-line"><dt>Provider</dt><dd>@Model.Provider</dd></div>
                    <div class="stat-line"><dt>Transaction id</dt><dd class="small">@Model.ExternalTransactionId</dd></div>
                    <div class="stat-line"><dt>Created</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd></div>
                    <div class="stat-line">
                        <dt>Paid</dt>
                        <dd>@(Model.PaidAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
                    </div>
                    <div class="stat-line">
                        <dt>Order</dt>
                        <dd>
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">
                                @Model.OrderTitle
                            </a>
                        </dd>
                    </div>
                    <div class="stat-line">
                        <dt>Payer</dt>
                        <dd>
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId">
                                @Model.UserName
                            </a>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-header"><i class="bi bi-gear"></i> Actions</div>
            <div class="card-body">
                @if (Model.Status == PaymentStatus.Completed)
                {
                    <p class="cell-muted">
                        Marking a payment as refunded only records the decision in ServiceHub. The money
                        itself has to be returned through @Model.Provider.
                    </p>
                    <form asp-action="Refund" method="post" data-confirm="Mark this payment as refunded?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-warning w-100">
                            <i class="bi bi-arrow-counterclockwise"></i> Mark as refunded
                        </button>
                    </form>
                }
                else
                {
                    <p class="cell-muted mb-0">
                        No actions are available for a payment in the @Model.Status state.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
