@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LoginLayout";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size:2.5rem"></i>
            <h2 class="h5 mt-3">@Model.StatusCode — @Model.Title</h2>
            <p class="cell-muted">@Model.Message</p>
            @if (!string.IsNullOrEmpty(Model.RequestId))
            {
                <p class="cell-muted small">Request id: <code>@Model.RequestId</code></p>
            }
            <a class="btn btn-primary mt-2" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2"></i> Back to dashboard
            </a>
        </div>
    </div>
}
else
{
    <div class="login-card text-center">
        <i class="bi bi-exclamation-triangle text-warning" style="font-size:2.5rem"></i>
        <h1 class="h5 mt-3">@Model.StatusCode — @Model.Title</h1>
        <p class="cell-muted">@Model.Message</p>
        <a class="btn btn-primary w-100 mt-2" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right"></i> Sign in
        </a>
    </div>
}
