@model PublicLoginViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = T("Вхід — Вибір");
}

@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }

<main class="auth">
    <div class="v-container auth__inner">
        <a class="auth-back" asp-controller="Landing" asp-action="Index" data-auth-back>
            <span aria-hidden="true">&lsaquo;</span> @T("Назад")
        </a>

        <div class="auth-card">
            <span class="auth-card__icon" aria-hidden="true">
                <partial name="_AuthFaceIcon" />
            </span>

            <h2>@T("Вхід")</h2>
            <p class="auth-card__lead">@T("Раді бачити вас знову!")</p>

            <form method="post" asp-action="Login" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <partial name="_AuthErrors" />

                <div class="auth-field">
                    <label asp-for="Email">@T("E-mail адресу")</label>
                    <span class="auth-input">
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="@T("Введіть e-mail")" />
                    </span>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password">@T("Пароль")</label>
                    <span class="auth-input" data-auth-password>
                        <input asp-for="Password" type="password" autocomplete="current-password" placeholder="@T("Введіть пароль")" />
                        <button class="auth-eye" type="button" aria-label="@T("Показати пароль")" data-label-show="@T("Показати пароль")" data-label-hide="@T("Приховати пароль")">
                            <partial name="_AuthEyeIcon" />
                        </button>
                    </span>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                    <span class="auth-forgot"><a asp-action="ForgotPassword">@T("Забули пароль?")</a></span>
                </div>

                <button class="auth-submit auth-submit--narrow" type="submit">@T("Продовжити")</button>
            </form>

            <p class="auth-or">@T("або увійдіть за допомогою")</p>

            <div class="auth-socials">
                @foreach (var (name, icon) in new[]
                {
                    ("Google", "google"), ("Facebook", "facebook"),
                    ("Linkedin", "linkedin"), ("Apple", "apple")
                })
                {
                    <button class="auth-social" type="button" disabled title="@F("Вхід через {0} буде доступний пізніше", name)">
                        <i class="bi bi-@icon" aria-hidden="true"></i> @name
                    </button>
                }
            </div>

            <p class="auth-switch">@T("Ще не має акаунту?") <a asp-action="Register" data-role-choice>@T("Зареєструватися")</a></p>

            <div class="auth-trust">
                <div>
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span><b>@T("Безпечно")</b>@T("Ваші дані під захистом")</span>
                </div>
                <div>
                    <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                    <span><b>@T("Швидко")</b>@T("Увійдіть за кілька секунд")</span>
                </div>
                <div>
                    <i class="bi bi-headset" aria-hidden="true"></i>
                    <span><b>@T("Підтримка 24/7")</b>@T("Ми завжди поруч")</span>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts { <script src="~/js/auth.js" asp-append-version="true" defer></script> }
