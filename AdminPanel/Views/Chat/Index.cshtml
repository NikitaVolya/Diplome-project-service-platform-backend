@model ChatViewModel
@{
    ViewData["Title"] = "Support chat";
    ViewData["Subtitle"] = Model.Selected == null
        ? "Order conversations between customers and executors"
        : $"Order #{Model.Selected.OrderId} — {Model.Selected.OrderTitle}";
}

<div class="chat-layout">

    <div class="card table-card">
        <div class="card-header"><i class="bi bi-inbox"></i> Dialogs</div>

        <div class="p-2 border-bottom">
            <form method="get" class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input class="form-control" name="search" value="@Model.Search" placeholder="Order or participant" />
                <button class="btn btn-outline-secondary" type="submit">Find</button>
            </form>
        </div>

        <div class="chat-list" id="dialogList">
            @if (!Model.Dialogs.Any())
            {
                <div class="empty-state"><i class="bi bi-chat-left"></i>Розмов ще немає</div>
            }

            @foreach (var dialog in Model.Dialogs)
            {
                <a class="chat-list__item @(Model.Selected?.OrderId == dialog.OrderId ? "is-active" : string.Empty)"
                   asp-action="Index" asp-route-orderId="@dialog.OrderId" asp-route-search="@Model.Search"
                   data-dialog="@dialog.OrderId">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="cell-strong text-truncate">#@dialog.OrderId @dialog.OrderTitle</span>
                        @if (dialog.UnreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill">@dialog.UnreadCount</span>
                        }
                    </div>
                    <div class="cell-muted text-truncate" data-preview="@dialog.OrderId">@dialog.LastMessage</div>
                    <div class="cell-muted small">
                        @dialog.CustomerName
                        @if (dialog.ExecutorName != null)
                        {
                            <text>· @dialog.ExecutorName</text>
                        }
                        @if (dialog.LastMessageAt.HasValue)
                        {
                            <text>· @Display.Relative(dialog.LastMessageAt.Value)</text>
                        }
                    </div>
                </a>
            }
        </div>
    </div>

    <div class="card">
        @if (Model.Selected == null)
        {
            <div class="card-body">
                <div class="empty-state">
                    <i class="bi bi-chat-dots"></i>
                    Оберіть розмову ліворуч, щоб прочитати повідомлення та відповісти
                </div>
            </div>
        }
        else
        {
            <div class="card-header">
                <i class="bi bi-chat-dots"></i>
                <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Selected.OrderId">
                    Order #@Model.Selected.OrderId
                </a>
                <span class="@Display.OrderStatusClass(Model.Selected.OrderStatus) ms-2">
                    @Display.OrderStatusLabel(Model.Selected.OrderStatus)
                </span>
                <span class="ms-auto cell-muted small" id="connectionState">
                    <i class="bi bi-circle-fill text-secondary"></i> connecting…
                </span>
            </div>

            <div class="chat-thread" id="chatThread">
                @foreach (var message in Model.Messages)
                {
                    var mine = message.SenderId == Model.CurrentUserId;
                    <div class="chat-msg @(mine ? "chat-msg--mine" : string.Empty)">
                        <div class="chat-msg__bubble">
                            @if (!mine)
                            {
                                <div class="cell-muted small fw-semibold">@message.SenderName</div>
                            }
                            <div>@message.Text</div>
                            <div class="chat-msg__meta">@message.SentAt.ToString("dd MMM HH:mm")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="card-body border-top">
                <div class="cell-muted small mb-2" id="typingIndicator"></div>
                <form id="chatForm" class="d-flex gap-2">
                    <input type="text" id="chatInput" class="form-control" maxlength="1000" autocomplete="off"
                           placeholder="Write as support…" />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-send"></i>
                    </button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        (function () {
            var orderId = @(Model.Selected?.OrderId ?? 0);
            var thread = document.getElementById('chatThread');
            var form = document.getElementById('chatForm');
            var input = document.getElementById('chatInput');
            var state = document.getElementById('connectionState');
            var typing = document.getElementById('typingIndicator');

            function scrollToEnd() {
                if (thread) { thread.scrollTop = thread.scrollHeight; }
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function appendMessage(message, mine) {
                if (!thread) { return; }

                var wrapper = document.createElement('div');
                wrapper.className = 'chat-msg' + (mine ? ' chat-msg--mine' : '');

                var time = new Date(message.sentAt).toLocaleString(undefined, {
                    day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
                });

                wrapper.innerHTML =
                    '<div class="chat-msg__bubble">' +
                    (mine ? '' : '<div class="cell-muted small fw-semibold">' + escapeHtml(message.senderName) + '</div>') +
                    '<div>' + escapeHtml(message.text) + '</div>' +
                    '<div class="chat-msg__meta">' + time + '</div>' +
                    '</div>';

                thread.appendChild(wrapper);
                scrollToEnd();
            }

            function setState(icon, text) {
                if (state) {
                    state.innerHTML = '<i class="bi bi-circle-fill ' + icon + '"></i> ' + text;
                }
            }

            scrollToEnd();

            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/admin-chat')
                .withAutomaticReconnect()
                .build();

            connection.on('ReceiveMessage', function (message) {
                if (message.orderId !== orderId) { return; }
                // Хаб повертає й власні повідомлення цього адміністратора, тому порівнюємо за ідентифікатором із сервера.
                appendMessage(message, message.senderId === '@Model.CurrentUserId');
            });

            connection.on('DialogUpdated', function (info) {
                var preview = document.querySelector('[data-preview="' + info.orderId + '"]');
                if (preview) { preview.textContent = info.preview; }
            });

            connection.on('UserTyping', function (name) {
                if (!typing) { return; }
                typing.textContent = name + ' is typing…';
                clearTimeout(typing.dataset.timer);
                typing.dataset.timer = setTimeout(function () { typing.textContent = ''; }, 2500);
            });

            connection.onreconnecting(function () { setState('text-warning', 'reconnecting…'); });
            connection.onreconnected(function () {
                setState('text-success', 'online');
                if (orderId) { connection.invoke('JoinDialog', orderId); }
            });
            connection.onclose(function () { setState('text-danger', 'offline'); });

            connection.start()
                .then(function () {
                    setState('text-success', 'online');
                    if (orderId) { return connection.invoke('JoinDialog', orderId); }
                })
                .catch(function (error) {
                    setState('text-danger', 'offline');
                    console.error('SignalR connection failed', error);
                });

            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    var text = input.value.trim();
                    if (!text || !orderId) { return; }

                    connection.invoke('SendMessage', orderId, text)
                        .then(function () { input.value = ''; })
                        .catch(function (error) { window.alert(error.message || 'Message could not be sent.'); });
                });

                var lastTyping = 0;
                input.addEventListener('input', function () {
                    var now = Date.now();
                    if (now - lastTyping > 1500 && orderId) {
                        lastTyping = now;
                        connection.invoke('Typing', orderId).catch(function () { });
                    }
                });
            }
        })();
    </script>
}
