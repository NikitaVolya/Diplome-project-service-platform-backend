@model StatisticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Statistics";
    ViewData["Subtitle"] = $"{Model.From:dd MMM yyyy} — {Model.To:dd MMM yyyy}";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var s = Model.Summary;

    var totalOrders = Model.Daily.Sum(d => d.TotalOrders);
    var totalCompleted = Model.Daily.Sum(d => d.CompletedOrders);
    var totalRevenue = Model.Daily.Sum(d => d.TotalRevenue);
    var totalUsers = Model.Daily.Sum(d => d.NewUsersCount);
}

<form method="get" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-lg-3">
            <label for="from">Від</label>
            <input id="from" type="date" class="form-control form-control-sm" name="from"
                   value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-3">
            <label for="to">До</label>
            <input id="to" type="date" class="form-control form-control-sm" name="to"
                   value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-lg-6 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel"></i> Apply</button>
            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               asp-route-from="@DateTime.UtcNow.Date.AddDays(-6).ToString("yyyy-MM-dd")"
               asp-route-to="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")">7 днів</a>
            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               asp-route-from="@DateTime.UtcNow.Date.AddDays(-29).ToString("yyyy-MM-dd")"
               asp-route-to="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")">30 днів</a>
            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               asp-route-from="@DateTime.UtcNow.Date.AddDays(-89).ToString("yyyy-MM-dd")"
               asp-route-to="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")">90 днів</a>

            <a class="btn btn-sm btn-outline-success ms-auto"
               asp-action="Export"
               asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To.ToString("yyyy-MM-dd")">
                <i class="bi bi-file-earmark-spreadsheet"></i> Експортувати в Excel
            </a>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="kpi">
            <div class="kpi__label">Orders in period</div>
            <div class="kpi__value">@totalOrders.ToString("N0")</div>
            <div class="kpi__meta">@totalCompleted completed</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi">
            <div class="kpi__label">Revenue in period</div>
            <div class="kpi__value">@totalRevenue.ToString("N0")<span class="fs-6 text-muted"> ₴</span></div>
            <div class="kpi__meta">avg. order @s.AverageOrderValue.ToString("N0") ₴</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi">
            <div class="kpi__label">New users</div>
            <div class="kpi__value">@totalUsers.ToString("N0")</div>
            <div class="kpi__meta">@s.TotalUsers total on the platform</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi">
            <div class="kpi__label">Completion rate</div>
            <div class="kpi__value">@s.CompletionRate.ToString("0.#")%</div>
            <div class="kpi__meta">avg. rating @s.AverageRating.ToString("0.0") ★</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-activity"></i> Orders</div>
            <div class="card-body">
                <div class="chart-box"><canvas id="statsOrders"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-star"></i> Rating distribution</div>
            <div class="card-body">
                <div class="chart-box"><canvas id="statsRatings"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-currency-exchange"></i> Revenue by month</div>
            <div class="card-body">
                <div class="chart-box chart-box--sm"><canvas id="statsRevenue"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-bar-chart"></i> Orders by category</div>
            <div class="card-body">
                <div class="chart-box chart-box--sm"><canvas id="statsCategories"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header"><i class="bi bi-table"></i> Daily breakdown</div>
    <div class="table-responsive" style="max-height:520px">
        <table class="table align-middle">
            <thead class="position-sticky top-0">
            <tr>
                <th>Date</th>
                <th class="text-end">Orders</th>
                <th class="text-end">Виконано</th>
                <th class="text-end">Виконання</th>
                <th class="text-end">Дохід</th>
                <th class="text-end">New users</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Daily.Any())
            {
                <tr><td colspan="6" class="empty-state"><i class="bi bi-calendar-x"></i>За цей період даних немає</td></tr>
            }

            @foreach (var day in Model.Daily)
            {
                var rate = day.TotalOrders == 0 ? 0 : day.CompletedOrders * 100.0 / day.TotalOrders;
                <tr>
                    <td class="cell-strong cell-nowrap">@day.Date.ToString("ddd, dd MMM yyyy")</td>
                    <td class="text-end">@day.TotalOrders</td>
                    <td class="text-end">@day.CompletedOrders</td>
                    <td class="text-end" style="min-width:120px">
                        <div class="d-flex align-items-center gap-2 justify-content-end">
                            <div class="progress progress-thin flex-grow-1" style="max-width:70px">
                                <div class="progress-bar bg-success" style="width:@rate.ToString("0")%"></div>
                            </div>
                            <span class="cell-muted">@rate.ToString("0")%</span>
                        </div>
                    </td>
                    <td class="text-end cell-nowrap">@day.TotalRevenue.ToString("N0") ₴</td>
                    <td class="text-end">@day.NewUsersCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var orders = @Html.Raw(JsonSerializer.Serialize(Model.OrdersChart, jsonOptions));
            var revenue = @Html.Raw(JsonSerializer.Serialize(Model.RevenueChart, jsonOptions));
            var ratings = @Html.Raw(JsonSerializer.Serialize(Model.RatingChart, jsonOptions));
            var categories = @Html.Raw(JsonSerializer.Serialize(Model.CategoryChart, jsonOptions));

            AdminCharts.line('statsOrders', orders, { maxTicks: 14 });
            AdminCharts.bar('statsRatings', ratings, { colorPerBar: true });
            AdminCharts.bar('statsRevenue', { labels: revenue.labels, series: [revenue.series[0]] });
            AdminCharts.bar('statsCategories', categories, { horizontal: true, colorPerBar: true, maxBarThickness: 16 });
        })();
    </script>
}
