@model CabinetPagerModel
@{
    const int window = 5;

    var first = Math.Max(1, Math.Min(Model.Page - 2, Model.Pages - window + 1));
    var last = Math.Min(Model.Pages, first + window - 1);
}

@if (Model.Pages > 1)
{
    <nav class="cab-pager" aria-label="Сторінки">
        <a class="@(Model.Page == 1 ? "is-off" : null)"
           asp-controller="Cabinet" asp-action="@Model.Action"
           asp-all-route-data="Model.For(Model.Page - 1)"
           aria-label="Попередня сторінка">&lsaquo;</a>

        @for (var i = first; i <= last; i++)
        {
            <a class="@(i == Model.Page ? "is-current" : null)"
               asp-controller="Cabinet" asp-action="@Model.Action"
               asp-all-route-data="Model.For(i)">@i</a>
        }

        @if (last < Model.Pages)
        {
            <span class="cab-pager__gap" aria-hidden="true">…</span>
        }

        <a class="@(Model.Page == Model.Pages ? "is-off" : null)"
           asp-controller="Cabinet" asp-action="@Model.Action"
           asp-all-route-data="Model.For(Model.Page + 1)"
           aria-label="Наступна сторінка">&rsaquo;</a>
    </nav>
}
