@model AdminComplaintListItem
@{
    ViewData["Title"] = $"Complaint #{Model.Id}";
    ViewData["Subtitle"] = Model.Reason;
}

<div class="mb-3">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to complaints
    </a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-exclamation-octagon"></i> @Model.Reason
                <span class="@Display.ComplaintStatusClass(Model.Status) ms-auto">@Model.Status</span>
            </div>
            <div class="card-body">
                <p class="mb-4">@Model.Description</p>

                <dl class="mb-0">
                    <div class="stat-line">
                        <dt>Filed</dt>
                        <dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>
                    </div>
                    <div class="stat-line">
                        <dt>From</dt>
                        <dd>
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.SenderId">
                                @Model.SenderName
                            </a>
                        </dd>
                    </div>
                    <div class="stat-line">
                        <dt>Against</dt>
                        <dd>
                            @if (Model.TargetUserId != null)
                            {
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.TargetUserId">
                                    @Model.TargetUserName
                                </a>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </dd>
                    </div>
                    <div class="stat-line">
                        <dt>Complaints against this user</dt>
                        <dd class="@(Model.TargetComplaintCount > 2 ? "text-danger" : string.Empty)">
                            @Model.TargetComplaintCount
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-check2-square"></i> Decision</div>
            <div class="card-body d-grid gap-2">
                @if (Model.Status == ComplaintStatus.Pending)
                {
                    <form asp-action="SetStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@ComplaintStatus.Resolved" />
                        <button class="btn btn-success w-100">
                            <i class="bi bi-check2"></i> Mark as resolved
                        </button>
                    </form>

                    <form asp-action="SetStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@ComplaintStatus.Rejected" />
                        <button class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-lg"></i> Reject complaint
                        </button>
                    </form>
                }
                else
                {
                    <p class="cell-muted mb-2">
                        This complaint has already been @Model.Status.ToString().ToLowerInvariant().
                    </p>
                    <form asp-action="SetStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@ComplaintStatus.Pending" />
                        <button class="btn btn-outline-warning w-100">
                            <i class="bi bi-arrow-counterclockwise"></i> Reopen
                        </button>
                    </form>
                }
            </div>
        </div>

        @if (Model.TargetUserId != null)
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-person-gear"></i> Act on the user</div>
                <div class="card-body d-grid gap-2">
                    <a class="btn btn-outline-secondary w-100" asp-controller="Users" asp-action="Details"
                       asp-route-id="@Model.TargetUserId">
                        <i class="bi bi-person"></i> Open profile
                    </a>

                    <form asp-controller="Users" asp-action="Block" method="post"
                          data-confirm="Block @Model.TargetUserName for 30 days?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.TargetUserId" />
                        <input type="hidden" name="days" value="30" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button class="btn btn-outline-warning w-100">
                            <i class="bi bi-slash-circle"></i> Block for 30 days
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
