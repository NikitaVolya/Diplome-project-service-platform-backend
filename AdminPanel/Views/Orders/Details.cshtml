@model AdminOrderDetails
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    ViewData["Subtitle"] = Model.Title;
    var canModerate = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Moderator);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> До списку замовлень
    </a>

    <div class="page-actions">
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Chat" asp-action="Index" asp-route-orderId="@Model.Id">
            <i class="bi bi-chat-dots"></i> Open chat (@Model.MessagesCount)
        </a>

        @if (canModerate)
        {
            <form asp-action="ChangeStatus" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-select form-select-sm" style="width:auto">
                    @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@status" selected="@(Model.Status == status)">
                            @Display.OrderStatusLabel(status)
                        </option>
                    }
                </select>
                <button class="btn btn-sm btn-primary"><i class="bi bi-check2"></i> Change status</button>
            </form>
        }

        @if (User.IsInRole(AppRoles.Admin))
        {
            <form asp-action="Delete" method="post" data-confirm="Видалити замовлення №@Model.Id назавжди?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-file-text"></i> Order details
                <span class="@Display.OrderStatusClass(Model.Status) ms-auto">
                    <i class="bi @Display.OrderStatusIcon(Model.Status)"></i>
                    @Display.OrderStatusLabel(Model.Status)
                </span>
            </div>
            <div class="card-body">
                <h2 class="h5">@Model.Title</h2>
                <p class="mb-3">@Model.Description</p>

                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <div class="kpi__label">Price</div>
                        <div class="cell-strong">@Model.Price.ToString("N2") ₴</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kpi__label">Category</div>
                        <div class="cell-strong">@Model.CategoryName</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kpi__label">Created</div>
                        <div class="cell-strong">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kpi__label">Execution</div>
                        <div class="cell-strong">@(Model.ExecutionAt?.ToString("dd MMM yyyy") ?? "—")</div>
                    </div>
                    <div class="col-12">
                        <div class="kpi__label mt-2">Адреса</div>
                        <div class="cell-strong"><i class="bi bi-geo-alt"></i> @Model.Address</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card table-card mb-3">
            <div class="card-header"><i class="bi bi-hand-index"></i> Applications (@Model.Applications.Count)</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th>Executor</th>
                        <th>Comment</th>
                        <th class="text-end">Offer</th>
                        <th>Status</th>
                        <th class="text-end">Sent</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Applications.Any())
                    {
                        <tr><td colspan="5" class="empty-state"><i class="bi bi-hand-index"></i>No applications</td></tr>
                    }
                    @foreach (var application in Model.Applications)
                    {
                        <tr>
                            <td>
                                @if (application.ExecutorId != null)
                                {
                                    <a class="cell-strong" asp-controller="Users" asp-action="Details" asp-route-id="@application.ExecutorId">
                                        @application.ExecutorName
                                    </a>
                                }
                                else
                                {
                                    <span class="cell-muted">@application.ExecutorName</span>
                                }
                            </td>
                            <td class="cell-muted cell-clip">@application.Comment</td>
                            <td class="text-end cell-nowrap">@application.ProposedPrice.ToString("N0") ₴</td>
                            <td><span class="@Display.ApplicationStatusClass(application.Status)">@application.Status</span></td>
                            <td class="text-end cell-muted cell-nowrap">@application.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Reviews.Any())
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-star"></i> Reviews</div>
                <div class="card-body pt-2">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="py-2 border-bottom">
                            <div class="d-flex justify-content-between">
                                @Display.Stars(review.Rating)
                                <span class="cell-muted">@review.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="mt-1">@review.Comment</div>
                            <div class="cell-muted">@review.AuthorName → @review.TargetUserName</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-xl-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-people"></i> Participants</div>
            <div class="card-body">
                <div class="kpi__label">Customer</div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="avatar">@Display.Initials(Model.CustomerName)</span>
                    <a class="cell-strong" asp-controller="Users" asp-action="Details" asp-route-id="@Model.CustomerId">
                        @Model.CustomerName
                    </a>
                </div>

                <div class="kpi__label">Executor</div>
                @if (Model.ExecutorId != null)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar">@Display.Initials(Model.ExecutorName)</span>
                        <a class="cell-strong" asp-controller="Users" asp-action="Details" asp-route-id="@Model.ExecutorId">
                            @Model.ExecutorName
                        </a>
                    </div>
                }
                else
                {
                    <div class="cell-muted">Ще не призначено</div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-credit-card"></i> Payments</div>
            <div class="card-body pt-2">
                @if (!Model.Payments.Any())
                {
                    <div class="empty-state py-4"><i class="bi bi-credit-card"></i>No payments</div>
                }
                @foreach (var payment in Model.Payments)
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="cell-strong">@payment.Amount.ToString("N2") @payment.Currency</div>
                            <div class="cell-muted">@payment.Provider · @payment.CreatedAt.ToString("dd MMM yyyy")</div>
                        </div>
                        <span class="@Display.PaymentStatusClass(payment.Status)">@payment.Status</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
