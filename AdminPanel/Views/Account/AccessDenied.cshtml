@{
    ViewData["Title"] = "Access denied";
    Layout = "_LoginLayout";
}

<div class="login-card text-center">
    <i class="bi bi-shield-lock text-danger" style="font-size:2.5rem"></i>
    <h1 class="h5 mt-3">Access denied</h1>
    <p class="cell-muted">
        Ваша роль не дозволяє відкрити цей розділ. Зверніться до адміністратора, щоб він надав
        the required permissions.
    </p>
    <a class="btn btn-primary w-100 mt-2" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-grid-1x2"></i> До дашборду
    </a>
</div>
